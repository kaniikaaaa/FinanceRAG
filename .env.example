# Postgres with pgvector. Neon's free tier has it built in — use the pooled
# connection string (the hostname contains "-pooler"), which is what serverless wants.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Free key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Only used when DATABASE_URL is unset, for a local Postgres.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=financerag
# DB_USER=postgres
# DB_PASSWORD=
